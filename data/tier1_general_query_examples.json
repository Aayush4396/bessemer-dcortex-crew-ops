      ],
      "expected_tool": "query_operations",
      "expected_plan": {
        "resource": "flights",
        "filters": {"date": "2026-09-15"},
        "fields": ["flight_id"],
        "aggregation": {"function": "count"},
        "limit": 500
      },
      "expected": {"count": 21, "aggregation_value": 21}
    },
