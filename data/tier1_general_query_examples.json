{
  "suite_id": "tier1-general-query-corpus-v1",
  "tier": 1,
  "snapshot_date": "2026-09-14",
  "purpose": "Natural-language examples for evaluating whether Tier 1 can plan and execute generalized, grounded SQLite analytics through query_operations.",
  "evaluation_notes": [
    "Each prompt variant under a case must resolve to the same expected_plan semantics.",
    "All supported cases must use query_operations and must be grounded in crew_ops.db.",
    "Expected assertions are snapshot-specific and were generated from the current SQLite database.",
    "The unsupported cases are intentional controls: the system should state the limitation or ask for clarification, never invent an answer.",
    "Passing this corpus demonstrates broad coverage of the current Tier 1 query DSL; it does not prove support for every possible natural-language query."
  ],
  "supported_cases": [
    {
      "id": "GQ001",
      "category": "flight_filter",
      "prompts": [
        "List all BLR to BOM flights on 15 September 2026 in departure order.",
        "Which flights operate from Bengaluru to Mumbai on 2026-09-15?"
      ],
      "expected_tool": "query_operations",
      "expected_plan": {
        "resource": "flights",
        "filters": {"date": "2026-09-15", "origin": "BLR", "destination": "BOM"},
        "fields": ["flight_id", "flight_no", "dep_utc"],
        "sort": ["dep_utc"],
        "limit": 500
      },
      "expected": {
        "count": 2,
        "ordered_flight_ids": ["DX431-2026-09-15", "DX412-2026-09-15"]
      }
    },
    {
      "id": "GQ002",
      "category": "flight_count",
      "prompts": [
