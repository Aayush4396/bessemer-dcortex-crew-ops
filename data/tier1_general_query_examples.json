  "unsupported_boundary_cases": [
    {
      "id": "GQ-U01",
      "prompt": "Group active crew by base and rank and count each group.",
      "missing_capability": "group_by",
      "expected_behavior": "State that grouped aggregation is not supported by the current query plan; do not fabricate grouped counts."
    },
    {
      "id": "GQ-U02",
      "prompt": "Show flights between 15 and 18 September with more than 150 seats.",
      "missing_capability": "range_and_comparison_filters",
      "expected_behavior": "State that non-duty range/comparison filters are unsupported or request a narrower exact filter."
    },
    {
      "id": "GQ-U03",
      "prompt": "Which active crew are not assigned to any pairing on 15 September?",
      "missing_capability": "anti_join",
      "expected_behavior": "State that the current generalized query resource cannot perform this anti-join; do not infer from partial lists."
    },
    {
      "id": "GQ-U04",
      "prompt": "Compare average duty hours between BLR and DEL crew.",
      "missing_capability": "grouped_comparison",
      "expected_behavior": "State that grouped comparative aggregation is not supported in one plan."
    },
    {
      "id": "GQ-U05",
      "prompt": "Predict which crew member will call in sick next month.",
      "missing_capability": "forecasting",
